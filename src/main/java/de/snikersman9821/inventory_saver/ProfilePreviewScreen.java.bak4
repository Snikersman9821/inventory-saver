package de.snikersman9821.inventory_saver;

import com.google.gson.JsonElement;
import com.mojang.serialization.JsonOps;
import net.minecraft.ChatFormatting;
import net.minecraft.client.Minecraft;
import net.minecraft.client.gui.GuiGraphicsExtractor;
import net.minecraft.client.gui.components.Button;
import net.minecraft.client.gui.components.EditBox;
import net.minecraft.client.gui.components.StringWidget;
import net.minecraft.client.gui.screens.Screen;
import net.minecraft.client.input.MouseButtonEvent;
import net.minecraft.core.registries.BuiltInRegistries;
import net.minecraft.network.chat.Component;
import net.minecraft.resources.Identifier;
import net.minecraft.resources.RegistryOps;
import net.minecraft.world.item.Item;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.Items;

import java.io.IOException;
import java.util.Arrays;
import java.util.Locale;
import java.util.Map;
import java.util.Optional;

/**
 * Shows the active profile in a vanilla-like inventory and lets you edit single slots
 * by typing an item id and a count. Changes are written to the profile file immediately.
 */
public class ProfilePreviewScreen extends Screen {
    private static final int PANEL_W = 176;
    private static final int PANEL_H = 166;

    private final Screen parent;
    private final String contextKey;
    private final int profile;
    private final InventoryStorage.SavedInventory saved;
    private final ItemStack[] shown = new ItemStack[InventoryActions.MENU_SIZE];
    private RegistryOps<JsonElement> ops;

    private int selected = -1;
    private int px;
    private int py;
    private EditBox itemBox;
    private EditBox countBox;
    private StringWidget statusWidget;
    private Component status = Component.empty();

    public ProfilePreviewScreen(Screen parent) {
        super(Component.translatable("inventory_saver.preview.title", ModConfig.effectiveSlot()));
        this.parent = parent;
        Minecraft mc = Minecraft.getInstance();
        this.profile = ModConfig.effectiveSlot();
        this.contextKey = InventoryStorage.contextKey(mc);

        InventoryStorage.SavedInventory loaded = InventoryStorage.load(contextKey, profile);
        if (loaded == null || loaded.stacks == null) {
            loaded = new InventoryStorage.SavedInventory();
            loaded.savedAt = System.currentTimeMillis();
        }
        this.saved = loaded;

        Arrays.fill(shown, ItemStack.EMPTY);
        if (mc.level != null) {
            this.ops = mc.level.registryAccess().createSerializationContext(JsonOps.INSTANCE);
            decodeAll();
        }
    }

    private void decodeAll() {
        for (Map.Entry<Integer, JsonElement> e : saved.stacks.entrySet()) {
            int slot = e.getKey();
            if (slot < InventoryActions.FIRST_SLOT || slot > InventoryActions.LAST_SLOT) {
                continue;
            }
            shown[slot] = ItemStack.CODEC.parse(ops, e.getValue())
                    .resultOrPartial(err -> InventorySaverMod.LOGGER.error("Could not decode stack: {}", err))
                    .orElse(ItemStack.EMPTY);
        }
    }

    @Override
    protected void init() {
        px = (this.width - PANEL_W) / 2;
        py = Math.max(20, (this.height - 228) / 2);
        int left = this.width / 2 - 152;
        int rowY = py + PANEL_H + 6;

        this.addRenderableWidget(new StringWidget(0, py - 13, this.width, 9,
                this.getTitle().copy().withStyle(ChatFormatting.GOLD), this.font).alignCenter());

        itemBox = new EditBox(this.font, left, rowY, 150, 20, Component.translatable("inventory_saver.preview.item"));
        itemBox.setMaxLength(100);
        itemBox.setHint(Component.translatable("inventory_saver.preview.item"));
        this.addRenderableWidget(itemBox);

        countBox = new EditBox(this.font, left + 154, rowY, 40, 20, Component.translatable("inventory_saver.preview.count"));
        countBox.setMaxLength(2);
        countBox.setFilter(s -> s.matches("\\d*"));
        countBox.setHint(Component.translatable("inventory_saver.preview.count"));
        this.addRenderableWidget(countBox);

        this.addRenderableWidget(Button.builder(Component.translatable("inventory_saver.preview.apply"), b -> apply())
                .bounds(left + 198, rowY, 54, 20).build());
        this.addRenderableWidget(Button.builder(Component.translatable("inventory_saver.preview.clear"), b -> clear())
                .bounds(left + 256, rowY, 48, 20).build());

        statusWidget = new StringWidget(0, rowY + 25, this.width, 9, status, this.font).alignCenter();
        this.addRenderableWidget(statusWidget);

        this.addRenderableWidget(Button.builder(Component.translatable("inventory_saver.config.done"), b -> this.onClose())
                .bounds(this.width / 2 - 100, rowY + 40, 200, 20).build());

        if (selected >= 0) {
            fillBoxes(selected);
        }
    }

    // ---- slot geometry (item position, the 18x18 frame starts 1 px up/left) ----

    private int slotX(int s) {
        if (s >= 5 && s <= 8) {
            return px + 8;
        }
        if (s >= 9 && s <= 44) {
            return px + 8 + ((s - 9) % 9) * 18;
        }
        return px + 77;
    }

    private int slotY(int s) {
        if (s >= 5 && s <= 8) {
            return py + 8 + (s - 5) * 18;
        }
        if (s >= 9 && s <= 35) {
            return py + 84 + ((s - 9) / 9) * 18;
        }
        if (s >= 36 && s <= 44) {
            return py + 142;
        }
        return py + 62;
    }

    private int slotAt(double mx, double my) {
        for (int s = InventoryActions.FIRST_SLOT; s <= InventoryActions.LAST_SLOT; s++) {
            int x = slotX(s);
            int y = slotY(s);
            if (mx >= x && mx < x + 16 && my >= y && my < y + 16) {
                return s;
            }
        }
        return -1;
    }

    // ---- rendering ----

    @Override
    public void extractRenderState(GuiGraphicsExtractor g, int mouseX, int mouseY, float partialTick) {
        super.extractRenderState(g, mouseX, mouseY, partialTick);

        Gfx.panel(g, px, py, PANEL_W, PANEL_H);
        Gfx.fill(g, px + 26, py + 8, px + 76, py + 78, 0xFF000000);
        for (int i = 0; i < 4; i++) {
            Gfx.slot(g, px + 97 + (i % 2) * 18, py + 17 + (i / 2) * 18);
        }
        Gfx.slot(g, px + 153, py + 27);

        int hovered = slotAt(mouseX, mouseY);
        for (int s = InventoryActions.FIRST_SLOT; s <= InventoryActions.LAST_SLOT; s++) {
            int x = slotX(s);
            int y = slotY(s);
            Gfx.slot(g, x - 1, y - 1);
            if (!shown[s].isEmpty()) {
                Gfx.item(g, this.font, shown[s], x, y);
            }
            if (s == selected) {
                Gfx.outline(g, x - 1, y - 1, 18, 18, 0xFFFFFF55);
            } else if (s == hovered) {
                Gfx.fill(g, x, y, x + 16, y + 16, 0x80FFFFFF);
            }
        }
        if (hovered >= 0 && !shown[hovered].isEmpty()) {
            Gfx.tooltip(g, this.font, shown[hovered], mouseX, mouseY);
        }
    }

    // ---- input ----

    @Override
    public boolean mouseClicked(MouseButtonEvent event, boolean doubleClick) {
        if (event.button() == 0) {
            int s = slotAt(event.x(), event.y());
            if (s >= 0) {
                selected = s;
                fillBoxes(s);
                setStatus("");
                return true;
            }
        }
        return super.mouseClicked(event, doubleClick);
    }

    private void fillBoxes(int s) {
        ItemStack st = shown[s];
        itemBox.setValue(st.isEmpty() ? "" : BuiltInRegistries.ITEM.getKey(st.getItem()).toString());
        countBox.setValue(st.isEmpty() ? "1" : Integer.toString(st.getCount()));
    }

    private void setStatus(String text) {
        status = Component.literal(text);
        if (statusWidget != null) {
            statusWidget.setMessage(status);
        }
    }

    private static Optional<Item> parseItem(String text) {
        Identifier id = Identifier.tryParse(text.toLowerCase(Locale.ROOT));
        if (id == null) {
            return Optional.empty();
        }
        return BuiltInRegistries.ITEM.getOptional(id).filter(i -> i != Items.AIR);
    }

    private void apply() {
        if (selected < 0) {
            setStatus("Click a slot first.");
            return;
        }
        String text = itemBox.getValue().trim();
        if (text.isEmpty()) {
            clear();
            return;
        }
        Optional<Item> item = parseItem(text);
        if (item.isEmpty()) {
            setStatus("Unknown item: " + text);
            return;
        }
        int count;
        try {
            count = Integer.parseInt(countBox.getValue().trim());
        } catch (NumberFormatException e) {
            setStatus("Count must be a number.");
            return;
        }
        ItemStack old = shown[selected];
        // Same item: keep enchantments, name etc. and only change the count.
        ItemStack stack = (!old.isEmpty() && old.getItem() == item.get()) ? old.copy() : new ItemStack(item.get());
        stack.setCount(Math.max(1, Math.min(stack.getMaxStackSize(), count)));
        place(selected, stack);
    }

    private void clear() {
        if (selected < 0) {
            setStatus("Click a slot first.");
            return;
        }
        place(selected, ItemStack.EMPTY);
    }

    private void place(int slot, ItemStack stack) {
        if (ops == null) {
            setStatus("Preview needs a loaded world.");
            return;
        }
        if (stack.isEmpty()) {
            saved.stacks.remove(slot);
        } else {
            Optional<JsonElement> json = ItemStack.CODEC.encodeStart(ops, stack)
                    .resultOrPartial(err -> InventorySaverMod.LOGGER.error("Could not encode stack: {}", err));
            if (json.isEmpty()) {
                setStatus("Could not encode the item.");
                return;
            }
            saved.stacks.put(slot, json.get());
        }
        saved.savedAt = System.currentTimeMillis();
        try {
            InventoryStorage.store(contextKey, profile, saved);
            shown[slot] = stack.isEmpty() ? ItemStack.EMPTY : stack;
            fillBoxes(slot);
            setStatus(stack.isEmpty() ? "Slot cleared." : "Slot updated.");
        } catch (IOException e) {
            InventorySaverMod.LOGGER.error("Could not write save file", e);
            setStatus("Saving failed: " + e.getMessage());
        }
    }

    @Override
    public void onClose() {
        Minecraft.getInstance().setScreenAndShow(parent);
    }
}
